# Generated by build.py — rebuild with `python3 build.py`
build/

# Packaged downloads, rebuilt on demand
*.zip

# A git bundle is a snapshot of this repo. Committing one into the repo
# makes every future bundle larger, which then gets committed too.
*.bundle

# Binary test fixtures, generated by tests/make-fixtures.py
tests/fixtures/

# The single-file build, produced by build.py from index.html + style.css +
# js/. Committing it means every source change also commits a 360KB
# regenerated blob, and the two can drift.
the-voice.html

# One-off delivery notes, regenerated per drop
CLEANUP-LIST.txt
*.bundle

# The browser suites need Playwright; it is installed on demand
# (`npm install playwright --no-save`) and must never be committed.
node_modules/
package-lock.json

# AETHER React studio keeps its own lockfile
!aether/package-lock.json
